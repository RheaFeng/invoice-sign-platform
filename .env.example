# ===== 服务配置 =====
PORT=3000
# 公网访问地址（部署后必填，用于生成签署链接和邮件）
BASE_URL=http://localhost:3000

# ===== 数据库 =====
# 本地默认使用 SQLite（无需配置）；生产建议用 Neon 免费 PostgreSQL：
# DATABASE_CLIENT=pg
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===== 安全 =====
# 字段级加密密钥（AES-256-GCM，必须 32 字节 base64，用以下命令生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 管理员会话 cookie 签名密钥（生成方式同上）
SESSION_SECRET=
# 首个管理员密码（首次启动自动创建管理员账号，登录后可自行修改）
ADMIN_INIT_PASSWORD=
# Vercel Cron 鉴权密钥（仅 Vercel 部署需要；任意长随机串，Vercel 触发提醒时自动携带）
CRON_SECRET=

# ===== 邮件（SMTP，可选）=====
# 配置后系统可自动发送签署链接邮件和每日提醒；
# 未配置时自动降级为生成 .eml 草稿，管理员在后台下载后手动发送
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rhea Feng <rhea.feng@aithoth.com>
MAIL_REPLY_TO=

# ===== 定时提醒 =====
# 每日提醒时间（北京时间），默认 10:00
REMINDER_CRON=0 10 * * *
# 提醒策略: ALL(每天提醒所有未签署) / INTERVAL(间隔提醒，见下)
REMINDER_STRATEGY=ALL
# INTERVAL 模式：每 N 天提醒一次未签署者
REMINDER_INTERVAL_DAYS=3
